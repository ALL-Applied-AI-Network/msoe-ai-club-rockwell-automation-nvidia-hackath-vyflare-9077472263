PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_MODE=real
# CPU default; add model2/resnet18/cosmos_full after configuring their runtimes.
ENABLED_MODELS=measurements,model4
# Optional shared server-to-server token for a deployed Python gateway.
INFERENCE_TOKEN=
# Required with INFERENCE_TOKEN for recipe promotion/demotion.
# Audit identity of the calling service, not an individually authenticated operator.
RECIPE_MANAGEMENT_ACTOR=
# Durable local recipe candidates, inspections and evidence (mount a disk in deployment).
# RECIPE_DB_PATH=/absolute/path/to/recipes.sqlite3
# Opt-in recognition/learning demonstration using packaged automatic observations.
# Uses its own bank; keep the normal bank path different. Writes require INFERENCE_TOKEN.
RECIPE_DEMO_ENABLED=false
# Engine 1.4 requires a new separate filename; preserve older pinned demo stores.
# RECIPE_DEMO_DB_PATH=/absolute/path/to/recipe-demo-v1-4.sqlite3
RESNET_DEVICE=cpu
# Leave checkpoint blank for ImageNet demonstration weights (downloads on first run).
RESNET_CHECKPOINT=
RESNET_LABELS=
# Cosmos3-Nano reasoner + Cosmos Framework guardrails. Linux/CUDA required.
COSMOS_CHECKPOINT=Cosmos3-Nano
COSMOS_MAX_NEW_TOKENS=256
# Latest codex/cosmos3-nano-finetune worker: experimental Version 1 LoRA.
# ssh -N -L 8002:127.0.0.1:7865 yt-vyflare71b7@172.30.102.122
COSMOS_FULL_URL=http://127.0.0.1:8002/backend/predict
COSMOS_EXPECTED_IMPLEMENTATION=cosmos3-nano-vial-lora
# Native Framework alternative: port 8001 /predict; unset expected implementation.
COSMOS_FULL_REMOTE_MODEL=cosmos
COSMOS_FULL_TIMEOUT_SECONDS=120

# Optional experimental Model 2: install requirements-model2.txt separately.
# Add model2 to ENABLED_MODELS; it is NOT approved as supporting evidence.
# MODEL2_BACKBONE_WEIGHTS=/absolute/path/to/resnet18-f37072fd.pth
