PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_MODE=mock
# Real mode: comma-separated resnet18,cosmos (both load once before serving).
ENABLED_MODELS=resnet18,cosmos
RESNET_DEVICE=cpu
# Leave checkpoint blank for ImageNet demonstration weights (downloads on first run).
RESNET_CHECKPOINT=
RESNET_LABELS=
# Cosmos3-Nano reasoner + Cosmos Framework guardrails. Linux/CUDA required.
COSMOS_CHECKPOINT=Cosmos3-Nano
COSMOS_MAX_NEW_TOKENS=256
