PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_MODE=mock
# Local gateway: Lite runs here, Full forwards to the DGX worker.
ENABLED_MODELS=resnet18,cosmos_lite,cosmos_full
RESNET_DEVICE=cpu
# Leave checkpoint blank for ImageNet demonstration weights (downloads on first run).
RESNET_CHECKPOINT=
RESNET_LABELS=
# Cosmos3-Nano reasoner + Cosmos Framework guardrails. Linux/CUDA required.
COSMOS_CHECKPOINT=Cosmos3-Nano
COSMOS_MAX_NEW_TOKENS=256
# Reach DGX loopback through: ssh -N -L 8001:127.0.0.1:8001 yt-vyflare71b7@172.30.102.122
COSMOS_FULL_URL=http://127.0.0.1:8001/predict
COSMOS_FULL_REMOTE_MODEL=cosmos
COSMOS_FULL_TIMEOUT_SECONDS=120
